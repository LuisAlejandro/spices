# Spices does not require application-specific environment variables for normal
# CLI or library use. Local development uses Docker via the Makefile
# (make console, make format, make lint, make test).

# Host user/group for docker-compose build (match your uid/gid; defaults 1000)
UID=1000
GID=1000

# Optional: used by scripts/docker-tests/local-docker-test.sh when running local Docker tests.
# LOG_LEVEL=INFO
# JSON_LOG=false
# ENABLE_COLORS=true
